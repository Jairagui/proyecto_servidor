# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
PORT=3000

# MongoDB en Docker (docker compose up -d)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=cambia-esta-contrasena
MONGO_DB=ecommerce

# Debe coincidir con los valores de arriba (o pega aquí tu URI de MongoDB Atlas)
MONGO_URI=mongodb://admin:cambia-esta-contrasena@127.0.0.1:27017/ecommerce?authSource=admin

# Mínimo 16 caracteres
JWT_SECRET=cambia-este-valor-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=7d
